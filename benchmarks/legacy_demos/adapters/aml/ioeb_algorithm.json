{
  "specVersion": "ioeb.algorithm-package/v1",
  "service": {
    "name": "aml-risk-predictor",
    "description": "Predict customer anti-money-laundering risk from profile and transaction records."
  },
  "entrypoint": "main:main_process",
  "parameterConstraints": {
    "customer_json": {"minLength": 2, "maxLength": 100000},
    "transactions_json": {"minLength": 2, "maxLength": 1000000},
    "country_risk_mapping_json": {"minLength": 2, "maxLength": 100000}
  },
  "tests": [
    {
      "name": "normal-customer",
      "arguments": {
        "customer_json": "{\"customer_id\":\"CUST000001\",\"name\":\"John Doe\",\"age\":45,\"nationality\":\"United States\",\"occupation\":\"Business Owner\",\"account_opening_date\":\"2020-01-15\",\"pep_status\":0,\"sanctions_match\":0,\"address_change_count\":1}",
        "transactions_json": "[{\"transaction_id\":\"TXN00000001\",\"customer_id\":\"CUST000001\",\"transaction_date\":\"2024-01-10 10:30:00\",\"amount\":500.0,\"transaction_type\":\"deposit\",\"is_cash_transaction\":0,\"is_cross_border\":0,\"country_code\":\"US\"},{\"transaction_id\":\"TXN00000002\",\"customer_id\":\"CUST000001\",\"transaction_date\":\"2024-01-15 14:20:00\",\"amount\":200.0,\"transaction_type\":\"withdrawal\",\"is_cash_transaction\":0,\"is_cross_border\":0,\"country_code\":\"US\"},{\"transaction_id\":\"TXN00000003\",\"customer_id\":\"CUST000001\",\"transaction_date\":\"2024-01-20 09:15:00\",\"amount\":1000.0,\"transaction_type\":\"transfer\",\"is_cash_transaction\":0,\"is_cross_border\":0,\"country_code\":\"US\"}]",
        "country_risk_mapping_json": "{\"US\":0}"
      },
      "expected": {
        "customer_id": "CUST000001",
        "is_suspicious": "0",
        "suspicious_probability": "0.12630651572370644",
        "risk_level": "low"
      }
    }
  ]
}
