{
  "specVersion": "ioeb.algorithm-package/v1",
  "service": {
    "name": "multibody-dynamics-simulation",
    "description": "Simulate a deterministic mass-spring-damper trajectory using PyDy."
  },
  "entrypoint": "main:main_process",
  "benchmark": {
    "source": "AMQ-Bench",
    "track": "ioeb-template",
    "sampleId": "meb_pydy_001",
    "repository": "https://github.com/pydy/pydy",
    "commit": "5205c01b4cf963ea463edd623161c0623e8b91f7"
  },
  "parameterConstraints": {
    "initial_conditions": {
      "minProperties": 5,
      "maxProperties": 5,
      "properties": {
        "position": {
          "description": "Initial displacement in meters.",
          "minimum": -1000000.0,
          "maximum": 1000000.0
        },
        "velocity": {
          "description": "Initial velocity in meters per second.",
          "minimum": -1000000.0,
          "maximum": 1000000.0
        },
        "mass": {
          "description": "Mass in kilograms.",
          "exclusiveMinimum": 0.0,
          "maximum": 1000000.0
        },
        "stiffness": {
          "description": "Spring stiffness in newtons per meter.",
          "exclusiveMinimum": 0.0,
          "maximum": 1000000.0
        },
        "damping": {
          "description": "Damping coefficient.",
          "minimum": 0.0,
          "maximum": 1000000.0
        }
      },
      "required": [
        "position",
        "velocity",
        "mass",
        "stiffness",
        "damping"
      ],
      "additionalProperties": false
    },
    "simulation_time": {
      "minimum": 0.1,
      "maximum": 60.0
    }
  },
  "tests": [
    {
      "name": "damped-oscillator-two-seconds",
      "arguments": {
        "system": "mass_spring_damper",
        "initial_conditions": {
          "position": 1.0,
          "velocity": 0.0,
          "mass": 1.0,
          "stiffness": 4.0,
          "damping": 0.2
        },
        "simulation_time": 2.0
      },
      "expected": {
        "system": "mass_spring_damper",
        "samples": "101",
        "final_position": "-0.569137",
        "final_velocity": "1.235410",
        "min_position": "-0.854378",
        "max_position": "1.000000"
      }
    }
  ]
}
