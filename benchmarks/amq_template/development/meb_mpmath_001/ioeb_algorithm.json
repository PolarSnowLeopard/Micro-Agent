{
  "specVersion": "ioeb.algorithm-package/v1",
  "service": {
    "name": "arbitrary-precision-math",
    "description": "Compute mathematical constants with controlled arbitrary precision."
  },
  "entrypoint": "main:main_process",
  "benchmark": {
    "source": "AMQ-Bench",
    "track": "ioeb-template",
    "sampleId": "meb_mpmath_001",
    "repository": "https://github.com/fredrik-johansson/mpmath",
    "commit": "7b40a40cc6b8961cfa9d1697e6e7075d42f56f0a"
  },
  "parameterConstraints": {
    "precision": {
      "minimum": 1,
      "maximum": 200
    }
  },
  "tests": [
    {
      "name": "pi-to-50-decimal-places",
      "arguments": {
        "expression": "pi",
        "precision": 50
      },
      "expected": {
        "expression": "pi",
        "precision": "50",
        "value": "3.14159265358979323846264338327950288419716939937511"
      }
    }
  ]
}
