{
  "specVersion": "ioeb.algorithm-package/v1",
  "service": {
    "name": "weighted-shortest-path",
    "description": "Compute deterministic shortest paths in weighted undirected graphs using NetworkX."
  },
  "entrypoint": "main:main_process",
  "benchmark": {
    "source": "AMQ-Bench",
    "track": "ioeb-template",
    "sampleId": "meb_networkx_002",
    "repository": "https://github.com/networkx/networkx",
    "commit": "4792afb8a8ef5812370398d5f543e8228e354ae8"
  },
  "parameterConstraints": {
    "edges": {
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "prefixItems": [
          {"minLength": 1, "maxLength": 100},
          {"minLength": 1, "maxLength": 100},
          {"exclusiveMinimum": 0.0, "maximum": 1000000000.0}
        ]
      }
    },
    "source": {
      "minLength": 1,
      "maxLength": 100
    },
    "target": {
      "minLength": 1,
      "maxLength": 100
    }
  },
  "tests": [
    {
      "name": "a-to-d-weighted-shortest-path",
      "arguments": {
        "edges": [
          ["A", "B", 1.0],
          ["A", "C", 4.0],
          ["B", "C", 2.0],
          ["B", "D", 6.0],
          ["C", "D", 3.0]
        ],
        "source": "A",
        "target": "D",
        "algorithm": "dijkstra"
      },
      "expected": {
        "path": ["A", "B", "C", "D"],
        "total_weight": "6.000000",
        "algorithm": "dijkstra"
      }
    }
  ]
}
