{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta_app_artifact_v1",
  "title": "MetaAppArtifact v1",
  "type": "object",
  "required": ["schemaVersion", "artifactId", "app", "taskContract", "runtime", "goldenPaths"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "meta_app_artifact.v1"},
    "artifactId": {"type": "string"},
    "app": {
      "type": "object",
      "required": ["name", "domain", "description"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string"},
        "domain": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "taskContract": {
      "type": "object",
      "required": ["goal", "domain", "inputSlots", "outputSlots", "constraints", "successCriteria"],
      "additionalProperties": true,
      "properties": {
        "goal": {"type": "string"},
        "domain": {"type": "string"},
        "inputSlots": {"type": "array"},
        "outputSlots": {"type": "array"},
        "constraints": {"type": "array"},
        "successCriteria": {"type": "array"}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["mode", "serviceBindings", "fallbackPolicy", "agent"],
      "additionalProperties": true,
      "properties": {
        "mode": {"enum": ["agent_only", "agent_with_optional_golden_path"]},
        "serviceBindings": {"type": "array"},
        "fallbackPolicy": {"type": "object"},
        "agent": {"type": "object"}
      }
    },
    "goldenPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pathId", "primary", "status", "applicability", "steps", "assertions", "fallbackPolicy"],
        "additionalProperties": true,
        "properties": {
          "pathId": {"type": "string"},
          "primary": {"type": "boolean"},
          "status": {"const": "active"},
          "applicability": {"type": "object"},
          "steps": {"type": "array"},
          "assertions": {"type": "array"},
          "fallbackPolicy": {"type": "object"}
        }
      }
    }
  }
}
