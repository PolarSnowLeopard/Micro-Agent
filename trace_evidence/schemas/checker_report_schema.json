{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checker_report_v0",
  "title": "Checker Report",
  "description": "Evidence checker report validating the quality and completeness of a trace evidence card.",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "session_id",
    "checked_at",
    "overall_status",
    "summary",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the checker report schema"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ev-[a-f0-9]{6}-[a-f0-9]{8}$",
      "description": "Evidence identifier this report validates"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Original trace session identifier"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when check was performed"
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "WARN_INCOMPLETE",
        "INCOMPLETE_TRACE"
      ],
      "description": "Overall report status: for complete traces, worst evidence-quality verdict (PASS/WARN/FAIL); for incomplete traces, mirrors completeness (WARN_INCOMPLETE/INCOMPLETE_TRACE)"
    },
    "summary": {
      "type": "object",
      "required": [
        "total_checks",
        "passed",
        "warnings",
        "failed",
        "missing"
      ],
      "properties": {
        "total_checks": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "completeness": {
          "type": "string",
          "description": "Completion-state verdict"
        },
        "quality_verdict": {
          "type": [
            "string",
            "null"
          ],
          "description": "Evidence-quality verdict, only meaningful when trace is COMPLETE"
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_name",
          "status",
          "detail"
        ],
        "properties": {
          "check_name": {
            "type": "string",
            "minLength": 1,
            "description": "Machine-readable check identifier"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "WARN",
              "FAIL",
              "MISSING"
            ],
            "description": "Check result status"
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation of the check result"
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of evidence items found for this check"
          },
          "missing_items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of specific items missing or problematic"
          },
          "remediation": {
            "type": "string",
            "description": "Actionable operator guidance for resolving non-PASS checks"
          },
          "category": {
            "type": "string",
            "enum": [
              "data",
              "logic"
            ],
            "description": "Evaluation dimension: data fidelity vs planning / control-flow logic"
          }
        },
        "additionalProperties": false
      }
    },
    "completeness": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "INCOMPLETE_TRACE",
        "WARN_INCOMPLETE",
        "UNKNOWN"
      ],
      "description": "Trace completion-state verdict (gates evidence-quality checks)"
    },
    "completeness_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Explanation for the completeness verdict"
    }
  },
  "additionalProperties": false
}