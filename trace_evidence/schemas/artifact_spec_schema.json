{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact_spec_v0.3",
  "title": "ArtifactSpec v0.3 — Meta-App Artifact Specification",
  "description": "结构化元应用产物 v0.3：结论型字段 + 可选 goldenPath；完整过程 trace 不落盘于产物。",
  "type": "object",
  "required": [
    "schemaVersion",
    "parsedIntent",
    "serviceContracts",
    "goldenPath",
    "solidificationReport",
    "artifactMeta"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "parsedIntent": {
      "type": "object",
      "required": ["goal", "domain"],
      "description": "轻量用户想定结论。",
      "properties": {
        "goal": {"type": "string"},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "acceptanceCriteria": {"type": "array", "items": {"type": "string"}},
        "domain": {"type": "string"},
        "description": {"type": "string"},
        "sourceRef": {
          "type": ["object", "null"],
          "properties": {
            "traceRef": {"type": "string"},
            "intakeSessionRef": {"type": ["string", "null"]},
            "parserModel": {"type": ["string", "null"]},
            "parsedAt": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "serviceContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["serviceId", "serviceName"],
        "properties": {
          "serviceId": {"type": "string", "minLength": 1},
          "serviceName": {"type": "string", "minLength": 1},
          "channel": {"type": ["string", "null"]},
          "transport": {"type": ["string", "null"]},
          "declaredTools": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "toolId": {"type": ["string", "null"]},
                "name": {"type": "string"},
                "description": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            }
          },
          "observedTools": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["toolName", "callCount"],
              "properties": {
                "toolName": {"type": "string"},
                "callCount": {"type": "integer", "minimum": 0},
                "successCount": {"type": "integer", "minimum": 0},
                "failureCount": {"type": "integer", "minimum": 0},
                "successRate": {"type": "number"},
                "avgLatencyMs": {"type": ["number", "null"]},
                "evidenceRefs": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "totalCalls": {"type": "integer", "minimum": 0},
          "overallSuccessRate": {"type": ["number", "null"]}
        },
        "additionalProperties": false
      }
    },
    "goldenPath": {
      "type": ["object", "null"],
      "description": "可复用黄金路径；不可抽取时为 null。",
      "properties": {
        "sourceTraceRef": {"type": "string"},
        "applicability": {
          "type": "object",
          "properties": {
            "inputSignature": {"type": "array", "items": {"type": "string"}},
            "requiredOutputs": {"type": "array", "items": {"type": "string"}},
            "requiredServices": {"type": "array", "items": {"type": "string"}},
            "hardConstraints": {"type": "array", "items": {"type": "string"}},
            "entryGuards": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stepId", "toolName", "contractRef", "inputBinding", "onFailure"],
            "properties": {
              "stepId": {"type": "string"},
              "toolName": {"type": "string"},
              "contractRef": {"type": "string"},
              "inputBinding": {"type": "object"},
              "outputSlots": {"type": "array", "items": {"type": "string"}},
              "assertionRefs": {"type": "array", "items": {"type": "string"}},
              "onFailure": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["assertionId", "level", "type", "result"],
            "properties": {
              "assertionId": {"type": "string"},
              "level": {
                "type": "string",
                "enum": ["L1_structure", "L2_dataflow", "L3_semantic"]
              },
              "type": {"type": "string"},
              "result": {"type": "string", "enum": ["pass", "fail", "unknown"]},
              "evidenceRefs": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "evidenceRefs": {"type": "array", "items": {"type": "string"}},
        "fallbackPolicy": {
          "type": "object",
          "properties": {
            "onInputMismatch": {"type": "string"},
            "onServiceUnavailable": {"type": "string"},
            "onToolFailure": {"type": "string"},
            "onAssertionFail": {"type": "string"},
            "onSafetyViolation": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "solidificationReport": {
      "type": "object",
      "required": [
        "solidifiable",
        "gates",
        "goldenPathExtractable",
        "goldenPathReason",
        "remediation"
      ],
      "properties": {
        "solidifiable": {"type": "boolean"},
        "conditions": {"type": "object"},
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gate", "passed", "detail"],
            "properties": {
              "gate": {"type": "string"},
              "passed": {"type": "boolean"},
              "detail": {"type": "string"},
              "remediation": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "goldenPathExtractable": {"type": "boolean"},
        "goldenPathReason": {"type": "string"},
        "remediation": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "artifactMeta": {
      "type": "object",
      "required": ["artifactId", "sourceSessionId", "createdAt", "artifactHash"],
      "properties": {
        "artifactId": {"type": "string"},
        "sourceSessionId": {"type": "string"},
        "createdAt": {"type": "string"},
        "appName": {"type": "string"},
        "domain": {"type": "string"},
        "mode": {"type": "string"},
        "appId": {"type": ["string", "null"]},
        "traceRef": {"type": "string"},
        "traceHash": {"type": "string"},
        "configSnapshotHash": {"type": "string"},
        "artifactHash": {"type": "string"},
        "compilerVersion": {"type": ["string", "null"]},
        "evidenceRef": {"type": ["string", "null"]},
        "intakeSessionRef": {"type": ["string", "null"]},
        "buildSummary": {
          "type": "object",
          "properties": {
            "totalIterations": {"type": "integer"},
            "finalStatus": {"type": "string"},
            "elapsedMs": {"type": "integer"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": ["object", "null"],
      "description": "证据检查结论摘要（非完整检查过程）。",
      "properties": {
        "evidenceId": {"type": ["string", "null"]},
        "checkerStatus": {"type": ["string", "null"]},
        "completeness": {"type": ["string", "null"]},
        "missingEvidenceCategories": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "writeBackDraft": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
