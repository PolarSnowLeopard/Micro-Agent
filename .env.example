# LLM 配置（优先级高于 config/default.toml）
LLM_MODEL=openrouter/qwen/qwen3.6-flash
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_REASONING_ENABLED=false
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192

# Agent 配置
AGENT_MAX_STEPS=30

# MCP 封装运行验收：static 仅做静态契约检查；docker 还会构建隔离镜像并执行工具发现/冒烟测试
# docker 模式要求运行 Micro-Agent 的受控 worker 可访问 Docker daemon，不应直接暴露公共 Docker socket
IOEB_PACKAGING_RUNTIME_VERIFY=static
# docker 模式下默认要求每个工具都有仓库证据支持的 smokeTest，避免“能启动”冒充“功能可用”
IOEB_PACKAGING_REQUIRE_FUNCTIONAL_VERIFY=true

# 工作目录（留空则使用 workspace/）
WORKSPACE_ROOT=

# 可选：AML 模型评测 MCP 服务地址
PROJECT_4_MCP=
